<Window x:Class="FormulaFloat.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FormulaFloat · 公式提取" Width="600" Height="730" MinWidth="520" MinHeight="660" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#F6F5FA" Closing="OnClosing">
 <Border BorderBrush="#E4E0EF" BorderThickness="1" Padding="25,0,25,20">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="DragTitle">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{StaticResource Accent}" CornerRadius="10" Width="36" Height="36"><TextBlock Text="ƒ" FontFamily="Cambria" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="FormulaFloat" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="让公式，轻松流动" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="设置" Click="SettingsClick" Background="Transparent" Padding="10,7"/><Button Content="收起 ↗" Click="CollapseClick" Background="Transparent" Padding="10,7"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="0,7,0,19"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="从屏幕到 LaTeX" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="框选一条公式，把转写交给视觉模型。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><Button x:Name="CaptureButton" Grid.Column="1" Content="＋ 截取公式" Style="{StaticResource Primary}" VerticalAlignment="Center" Click="CaptureClick"/></Grid>
   <Border Grid.Row="2" Background="White" BorderBrush="#E8E4F0" BorderThickness="1" CornerRadius="12" Padding="15" Height="126" Margin="0,0,0,17">
    <Grid><TextBlock x:Name="EmptyImage" Text="⌁&#x0a;截图会显示在这里" TextAlignment="Center" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Image x:Name="SourceImage" Stretch="Uniform"/><Border Background="#EEFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4" Padding="6,2"><TextBlock Text="原始截图" Foreground="{StaticResource Muted}" FontSize="10"/></Border></Grid>
   </Border>
   <Grid Grid.Row="3" Margin="0,0,0,15"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10"><TextBlock Text="LATEX" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="UndoButton" Content="撤销调整" Click="UndoClick" Background="Transparent" Padding="9,4" IsEnabled="False"/><Button x:Name="RetryButton" Content="重新识别" Click="RetryClick" Background="Transparent" Padding="9,4" IsEnabled="False"/></StackPanel></DockPanel>
    <TextBox Grid.Row="1" x:Name="LatexBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Code,Consolas" FontSize="15" Background="White" TextChanged="LatexChanged" AutomationProperties.Name="LaTeX 公式源码"/>
    <DockPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="可直接编辑源码" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CopyMathButton" Content="复制 $$ 公式" Click="CopyMathClick" Padding="11,7" Margin="0,0,7,0" IsEnabled="False"/><Button x:Name="CopyButton" Content="复制 LaTeX" Click="CopyClick" Padding="11,7" IsEnabled="False"/></StackPanel></DockPanel>
   </Grid>
   <Border Grid.Row="4" Background="#EDE9F8" CornerRadius="12" Padding="15"><StackPanel><TextBlock Text="还想调整一下？" FontWeight="SemiBold"/><TextBlock Text="例如：将 x 改为 α，或整理为 aligned 多行公式" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="InstructionBox" AutomationProperties.Name="公式调整要求" KeyDown="InstructionKeyDown" MaxLength="4000"/><Button x:Name="RefineButton" Grid.Column="1" Content="调整 →" Margin="8,0,0,0" Style="{StaticResource Primary}" Click="RefineClick" IsEnabled="False"/></Grid></StackPanel></Border>
   <Grid Grid.Row="5" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="先配置视觉模型，即可开始。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/><TextBlock x:Name="ShortcutText" Text="Ctrl + Alt + M 截图 · 关闭窗口后保留悬浮球" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" x:Name="CancelButton" Content="取消" Click="CancelClick" Padding="10,5" Visibility="Collapsed"/></Grid>
  </Grid>
 </Border>
</Window>

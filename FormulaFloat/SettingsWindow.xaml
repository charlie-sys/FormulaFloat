<Window x:Class="FormulaFloat.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="模型设置" Width="500" Height="610" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F6F5FA">
 <StackPanel Margin="28,23">
  <TextBlock Text="连接你的视觉模型" FontSize="23" FontWeight="SemiBold"/>
  <TextBlock Text="支持兼容 Chat Completions 的图片输入接口。" Foreground="{StaticResource Muted}" Margin="0,8,0,20"/>
  <TextBlock Text="接口地址" Margin="0,0,0,6"/><TextBox x:Name="EndpointBox" AutomationProperties.Name="接口地址"/>
  <TextBlock Text="填到 /v1 或完整 /chat/completions；本机可使用 HTTP。" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,13"/>
  <TextBlock Text="模型名称" Margin="0,0,0,6"/><TextBox x:Name="ModelBox" AutomationProperties.Name="模型名称"/>
  <TextBlock Text="请填写服务商提供的视觉模型 ID。" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,13"/>
  <TextBlock Text="API Key（本机免鉴权服务可留空）" Margin="0,0,0,6"/><PasswordBox x:Name="KeyBox" Padding="10" BorderBrush="#E7E4F0" Background="#FAF9FD" AutomationProperties.Name="API Key"/>
  <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><TextBlock Text="请求超时（10–300 秒）" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="TimeoutBox" AutomationProperties.Name="超时秒数"/></Grid>
  <TextBlock Text="截图及调整要求将发送至以上地址；密钥由当前 Windows 用户加密保存。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,15,0,12"/>
  <TextBlock x:Name="ErrorText" Foreground="#B34764" FontSize="11" TextWrapping="Wrap"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button Content="保存设置" Style="{StaticResource Primary}" Click="SaveClick" IsDefault="True"/></StackPanel>
 </StackPanel>
</Window>
